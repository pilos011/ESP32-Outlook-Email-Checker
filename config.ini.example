; ============================================================
;  config.ini.example — Outlook Mail LED 설정 템플릿
; ============================================================
;  1. 이 파일을 config.ini 로 복사하세요.
;  2. 각 항목을 실제 값으로 채우세요.
;  3. PlatformIO 빌드 시 scripts/gen_config.py 가 자동으로
;     src/config_generated.h 를 생성합니다.
;
;  ※ config.ini 는 .gitignore 에 포함돼 있어 Git에 올라가지 않습니다.
; ============================================================

[wifi]
ssid     = YourWiFiSSID
password = YourWiFiPassword

[outlook]
; 본인의 이메일 주소 (수신인/참조인 매칭에 사용)
my_email = you@example.com

; 적색 LED + 비프 트리거할 특정 발신인 이메일 (소문자, 콤마 구분)
vip_senders = boss@example.com,important@example.com

; Azure AD 앱 등록 후 받은 Application (client) ID
; → Azure Portal > App registrations > Overview > Application (client) ID
client_id = xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

; 테넌트
;   회사 계정: Azure Portal > App registrations > Overview > Directory (tenant) ID
;   개인 outlook.com 계정: consumers
tenant = xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

[poll]
; 받은편지함 폴링 주기 (초)
interval_sec = 10

; 한 번에 가져올 최신 메일 개수 (1~25 권장)
top_n = 5

[led]
; WS2812 RGB LED GPIO 핀 (ESP32-S3-DevKitC-1: 48)
pin = 48

; LED 밝기 0~255 (눈에 따가우면 낮추세요. 5~30 권장)
brightness = 5

; 점멸 주기 (밀리초)
blink_ms = 500

[schedule]
; 평일 근무시간에만 동작 (true) / 24시간 동작 (false)
work_hours_only = true

; 근무 시작/종료 시각 (HH:MM, 24시간제)
work_start = 08:00
work_end   = 17:00

; 예약 알림 부저 (최대 8개, BLE로 런타임 추가/삭제 가능)
; 형식: HHMM:w  (w: 0=일, 1=월, 2=화, 3=수, 4=목, 5=금, 6=토, 7=평일)
sched_count = 1
sched_0     = 0900:7

[buzzer]
; 부저 GPIO 핀 (안전한 핀: 21, 13, 1)
;   주의: 19/20 = USB JTAG 충돌 금지
;   주의: 33~37 = PSRAM 충돌 금지
pin = 13

; 음량 0~100 (PWM duty 비율)
volume = 70

; 부저 톤 주파수 (Hz). Passive Buzzer 권장: 2000~3000
freq = 2700

; 비프 길이 (밀리초)
duration_ms = 200

[ble]
; BLE 설정 콘솔 접근 PIN (숫자/문자 자유, 4자리 이상 권장)
; nRF Connect 앱에서 연결 후 첫 번째 명령: AUTH:여기에PIN
; 잘못된 PIN은 거부되며, 연결 해제 시 자동으로 인증이 초기화됩니다.
pin = 1234

[oled]
; 0.91인치 128×32 SSD1306 I2C OLED
sda = 8
scl = 9

; 비근무시간 OLED 동작: idle (시계 표시) / off (화면 끄기)
off_hours_oled = idle

; 이메일 알림 화면 스크롤 속도 (밀리초/픽셀, 작을수록 빠름)
scroll_subject_ms = 50
scroll_sender_ms  = 50
